# Public installation form: replace the placeholders for YOUR installation.
# Database login: choose these BEFORE the first start (not your browser login).
DB_USER=gpxdash
# Replace this value. Single quotes keep $ and # literal. Minimum 12 characters.
DB_PASSWORD='CHANGE_ME_BEFORE_STARTING'

# Start on your trusted home network, then create the admin in your browser.
# Do not expose this HTTP setup to the Internet.
GPXDASH_GATEWAY_REQUIRED=false
GPXDASH_AUTH_COOKIE_SECURE=false

# Optional HTTPS gateway setup: enter addresses and exact connector IPs,
# then set BOTH settings above to true. No trailing slash on addresses.
GPXDASH_PUBLIC_ORIGIN=
GPXDASH_DEVICE_PUBLIC_ORIGIN=
GPXDASH_TRUSTED_PROXY_IPS=

# Optional extra HTTPS addresses, comma-separated.
# GPXDASH_ALTERNATE_ORIGINS=
# GPXDASH_DEVICE_ALTERNATE_ORIGINS=

# Later edits to DB_USER/DB_PASSWORD do not change an existing database login.
# Once filled in, this file is private: do not publish or commit your values.
# Back up your populated .env and data/config with a consistent database backup.
